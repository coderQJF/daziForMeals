.tabbar {
  position: fixed;
  z-index: 999;
  right: 16rpx;
  bottom: calc(env(safe-area-inset-bottom) + 28rpx);
  left: 16rpx;
  display: flex;
  height: 112rpx;
  padding: 12rpx 8rpx 10rpx;
  align-items: flex-start;
  border-top: 1rpx solid rgba(91, 67, 49, 0.05);
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 -9rpx 30rpx rgba(75, 47, 27, 0.052);
  box-sizing: content-box;
}

.tabbar__item {
  position: relative;
  display: flex;
  width: 33.333%;
  min-width: 0;
  height: 108rpx;
  flex: 0 0 33.333%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.tabbar__icon {
  position: relative;
  z-index: 1;
  display: block;
  width: 56rpx;
  height: 56rpx;
}

.tabbar__text {
  position: relative;
  z-index: 1;
  margin-top: 5rpx;
  font-size: 24rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

.tabbar__item--active .tabbar__text {
  font-weight: 700;
}
